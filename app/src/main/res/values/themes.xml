<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nagomi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#020617</item>
        <item name="android:statusBarColor">#020617</item>
    </style>

    <style name="Theme.Nagomi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E163D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/nagomi_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">#1E163D</item>
        <item name="postSplashScreenTheme">@style/Theme.Nagomi</item>
    </style>
</resources>
